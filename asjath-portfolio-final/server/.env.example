# Backend — copy to .env (never commit .env)
# Do not put real SMTP passwords, API keys, or database credentials in source control.

NODE_ENV=development
PORT=5000

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JSON / form body size limit
JSON_BODY_LIMIT=32kb

# Contact rate limit (per client IP)
CONTACT_RATE_WINDOW_MS=900000
CONTACT_RATE_MAX=8

# Set to 1 when behind a reverse proxy (nginx, Cloudflare)
TRUST_PROXY=0

# --- Optional future integrations (leave empty) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=
# DATABASE_URL=
